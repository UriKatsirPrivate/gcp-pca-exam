{
  "name": "gcp-pca-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:validate && npm run content:lint && { npm run --silent tts:check || true; }",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:lint": "tsx scripts/lint-content.ts",
    "tts:check": "tsx scripts/check-tts-freshness.ts",
    "tts:generate": "tsx scripts/generate-tts.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@anthropic-ai/vertex-sdk": "^0.17.1",
    "@auth/prisma-adapter": "^2.11.2",
    "@google-cloud/cloud-sql-connector": "^1.11.1",
    "@google-cloud/storage": "^8.2.0",
    "@google-cloud/text-to-speech": "^7.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "countries-and-timezones": "^3.9.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.20.0",
    "mermaid": "^11.15.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
