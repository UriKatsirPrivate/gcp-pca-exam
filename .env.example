# ---- Database (PostgreSQL) ----
# Local dev (see docker-compose.yml): postgres on localhost:5432
DATABASE_URL="postgresql://pca:pca@localhost:5432/pca?schema=public"
# Cloud SQL via Cloud Run unix socket (production) — note `localhost` host + ?host=/cloudsql/...
# DATABASE_URL="postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
# In production behind Cloud Run set the canonical URL:
# AUTH_URL="https://your-service-xxxx-uc.a.run.app"
# AUTH_TRUST_HOST=true
# Google OAuth ("Login with Google"). Create an OAuth 2.0 Web client in GCP
# Console (APIs & Services / Google Auth Platform) with redirect URI
# <origin>/api/auth/callback/google. Auth.js auto-detects these var names.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- LLM feedback engine (Claude) ----
# Provider: "vertex" (default, uses GCP ADC) or "anthropic" (direct API key) or "none" (rule-based only)
LLM_PROVIDER="vertex"
# Vertex (Claude on Vertex AI) — uses Application Default Credentials, no key needed:
ANTHROPIC_VERTEX_PROJECT_ID="landing-zone-demo-341118"
CLOUD_ML_REGION="global"
# Direct Anthropic API (only if LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY="sk-ant-..."
# Model ids:
LLM_MODEL_HEAVY="claude-opus-4-8"
LLM_MODEL_FAST="claude-haiku-4-5"
