# ---- Database (PostgreSQL) ----
# The connection path is chosen purely by env vars (no code change to flip):
#
# A) Neon / local dev — set DATABASE_URL, leave CLOUD_SQL_CONNECTION_NAME unset.
DATABASE_URL="postgresql://pca:pca@localhost:5432/pca?schema=public"
# Neon example: postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
#
# B) Cloud SQL (prod) — passwordless IAM via the Cloud SQL Node connector.
#    Set these instead of DATABASE_URL (the runtime service account authenticates
#    with its own IAM identity; no DB password). DB_USER = the SA email WITHOUT
#    the ".gserviceaccount.com" suffix, e.g. pca-app@PROJECT_ID.iam
# CLOUD_SQL_CONNECTION_NAME="PROJECT:REGION:INSTANCE"
# DB_USER="pca-app@PROJECT_ID.iam"
# DB_NAME="pca"
# DB_IAM_AUTH="true"          # set "false" to use DB_PASSWORD over the connector
# CLOUD_SQL_IP_TYPE="PUBLIC"  # PUBLIC | PRIVATE | PSC
# DB_PASSWORD=""              # only when DB_IAM_AUTH=false
# DB_POOL_MAX="5"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
# In production behind Cloud Run set the canonical URL:
# AUTH_URL="https://your-service-xxxx-uc.a.run.app"
# AUTH_TRUST_HOST=true
# Google OAuth ("Login with Google"). Create an OAuth 2.0 Web client in GCP
# Console (APIs & Services / Google Auth Platform) with redirect URI
# <origin>/api/auth/callback/google. Auth.js auto-detects these var names.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Allowlist: comma-separated emails that are ALWAYS allowed and admin (bootstrap).
# Only these + emails added in the admin console (/admin) can sign in.
ADMIN_EMAILS="you@example.com"

# ---- LLM feedback engine (Claude) ----
# Provider: "vertex" (default, uses GCP ADC) or "anthropic" (direct API key) or "none" (rule-based only)
LLM_PROVIDER="vertex"
# Vertex (Claude on Vertex AI) — uses Application Default Credentials, no key needed:
ANTHROPIC_VERTEX_PROJECT_ID="landing-zone-demo-341118"
CLOUD_ML_REGION="global"
# Direct Anthropic API (only if LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY="sk-ant-..."
# Model ids:
LLM_MODEL_HEAVY="claude-opus-4-8"
LLM_MODEL_FAST="claude-haiku-4-5"
